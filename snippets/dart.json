{
  "Jaspr Stateless Component": {
    "prefix": "jstless",
    "description": "Insert a StatelessComponent",
    "body": [
      "class $1 extends StatelessComponent {",
      "  const $1({super.key});",
      "",
      "  @override",
      "  Component build(BuildContext context) {",
      "    return ${0:div([])};",
      "  }",
      "}"
    ]
  },
  "Jaspr Stateful Component": {
    "prefix": "jstful",
    "description": "Insert a StatefulComponent",
    "body": [
      "class $1 extends StatefulComponent {",
      "  const $1({super.key});",
      "",
      "  @override",
      "  State<$1> createState() => _$1State();",
      "}",
      "",
      "class _$1State extends State<$1> {",
      "  @override",
      "  Component build(BuildContext context) {",
      "    return ${2:div([$3])};",
      "  }",
      "}"
    ]
  },
  "Jaspr HTML Component": {
    "prefix": "jhtml",
    "description": "Insert a html component",
    "body": [
      "$1([$2]),"
    ]
  },
  "Jaspr Text Component": {
    "prefix": "jtext",
    "description": "Insert a text component",
    "body": [
      "text(\"$1\"),"
    ]
  },
  "Jaspr Styles": {
    "prefix": "jstyls",
    "description": "Insert a styles definition",
    "body": [
      "@css",
      "List get styles => [",
      "  css('$1', [",
      "    css('&').styles(",
      "      $2,",
      "    ),",
      "  ]),",
      "];"
    ]
  },
  "Jaspr Event": {
    "prefix": "jevt",
    "description": "Insert an event handler",
    "body": [
      "events: {'$1': (event) {",
      "  $2",
      "}},"
    ]
  },
  "Jaspr Click Event": {
    "prefix": "jclick",
    "description": "Insert a click event handler",
    "body": [
      "events: events(onClick: () {",
      "  $2",
      "}),"
    ]
  },
  "Jaspr Inherited Component": {
    "prefix": "jinherited",
    "description": "Insert an InheritedComponent with of(context) helper",
    "body": [
      "class $1 extends InheritedComponent {",
      "  const $1({",
      "    required super.child,",
      "    super.key,",
      "  });",
      "",
      "  static $1 of(BuildContext context) {",
      "    final $1? result =",
      "        context.dependOnInheritedComponentOfExactType<$1>();",
      "    assert(result != null, 'No $1 found in context');",
      "    return result!;",
      "  }",
      "",
      "  @override",
      "  bool updateShouldNotify(covariant $1 oldComponent) {",
      "    return ${2:false};",
      "  }",
      "}"
    ]
  },
  "Jaspr Async Stateless Component": {
    "prefix": "jasync",
    "description": "Insert an AsyncStatelessComponent for async SSR/data loading",
    "body": [
      "class $1 extends AsyncStatelessComponent {",
      "  const $1({super.key});",
      "",
      "  @override",
      "  Future<Component> build(BuildContext context) async {",
      "    $2",
      "    return ${0:div([])};",
      "  }",
      "}"
    ]
  },
  "Jaspr Client Component": {
    "prefix": "jclient",
    "description": "Insert a @client StatelessComponent for browser interactivity",
    "body": [
      "@client",
      "class $1 extends StatelessComponent {",
      "  const $1({super.key});",
      "",
      "  @override",
      "  Component build(BuildContext context) {",
      "    return ${0:div([])};",
      "  }",
      "}"
    ]
  },
  "Jaspr Fragment": {
    "prefix": "jfragment",
    "description": "Insert a multi-root .fragment([...]) return",
    "body": [
      "return .fragment([",
      "  $0",
      "]);"
    ]
  },
  "Jaspr Route": {
    "prefix": "jroute",
    "description": "Insert a jaspr_router Route",
    "body": [
      "Route(",
      "  path: '$1',",
      "  builder: (context, state) => ${2:const $3()},",
      "),"
    ]
  },
  "Jaspr Anchor": {
    "prefix": "ja",
    "description": "Insert an anchor / link component",
    "body": [
      "a(href: '$1', [.text('$2')]),"
    ]
  }
}
